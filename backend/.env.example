# Copy to backend/.env and fill in. Never commit backend/.env.
# ./run.sh (repo root) creates this file with random values if it is missing.

# Required. Random string of at least 32 characters (python -c "import secrets;print(secrets.token_urlsafe(48))").
JWT_SECRET=
# Required. One demo password shared by every persona and the admin user (demo only, see README).
DEMO_PASSWORD=
# dev (default) generates a JWT secret when missing; production refuses to start without one.
APP_ENV=dev
# Freeze the engine clock for reproducible demos (YYYY-MM-DD). Empty = real today.
DEMO_TODAY=2026-09-30

# Optional: Gemini narration. Preferred: Gemini Developer API key (free key from aistudio.google.com, personal account).
GEMINI_API_KEY=
# Alternative: Vertex AI with application-default credentials (gcloud auth application-default login).
# Leave both empty for deterministic template narration (fully offline).
GCP_PROJECT=
GCP_LOCATION=europe-west1
GEMINI_MODEL=gemini-2.5-flash

# Optional: ElevenLabs voice notes. Empty = /me/voice returns 404.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_NL=
ELEVENLABS_VOICE_FR=
# Optional: English voice id (falls back to the Dutch voice)
ELEVENLABS_VOICE_EN=
ELEVENLABS_MODEL=eleven_multilingual_v2

# CORS: only this origin may call the API from a browser.
FRONTEND_ORIGIN=http://localhost:5173
